{
  "name": "baritone-workspace",
  "private": true,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saintly-Software/baritone.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests",
    "test": "pnpm test:unit && pnpm test:storybook",
    "test:unit": "vitest run --config .config/vitest.config.ts --project \"unit:*\" --project conventions",
    "test:storybook": "pnpm test:storybook:run || pnpm test:storybook:run",
    "test:storybook:run": "vitest run --config .config/vitest.config.ts --project storybook",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "storybook": "pnpm --filter @saintly-software/baritone-storybook storybook",
    "build-storybook": "pnpm --filter @saintly-software/baritone-storybook build-storybook",
    "prepare": "playwright install chromium && husky",
    "lint": "pnpm lint:check --fix",
    "lint:check": "pnpm exec oxlint -c .config/.oxlintrc.json --max-warnings=0",
    "fmt": "pnpm exec oxfmt -c .config/.oxfmtrc.json",
    "fmt:check": "pnpm fmt --check",
    "pub:version": "pnpm exec changeset version",
    "pub:release": "pnpm build && pnpm exec changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/css": "1.20.1",
    "@vanilla-extract/dynamic": "2.1.5",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/sprinkles": "1.6.5",
    "@vanilla-extract/vite-plugin": "5.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint -c .config/.oxlintrc.json --fix",
      "oxfmt -c .config/.oxfmtrc.json"
    ],
    "*.{json,md,css}": [
      "oxfmt -c .config/.oxfmtrc.json"
    ]
  },
  "packageManager": "pnpm@11.8.0"
}

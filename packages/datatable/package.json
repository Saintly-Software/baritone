{
  "name": "@saintly-software/baritone-datatable",
  "version": "1.0.0-alpha.11",
  "description": "DataTable for the Baritone design system, built on TanStack Table.",
  "keywords": [
    "baritone",
    "data-table",
    "design-system",
    "react",
    "tanstack-table"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
